{
  "name": "zoomy-zoom-freeze-animation",
  "version": "1.0.0",
  "description": "Deterministic keyframed animation for ZOOMY ZOOM FREEZE preschool song",
  "scripts": {
    "preview": "remotion preview",
    "render:draft": "remotion render ZoomyZoomFreeze out/draft.mp4 --overwrite",
    "render:final": "remotion render ZoomyZoomFreeze out/FINAL_Zoomy_Zoom_Freeze_Animation.mp4 --overwrite",
    "prepare:assets": "node scripts/download-assets.js",
    "qa:submit": "node scripts/qa-submit.js out/draft.mp4",
    "qa:loop": "bash scripts/qa-loop.sh",
    "verify:freeze": "node scripts/verify-freeze-frames.js out/draft.mp4"
  },
  "dependencies": {
    "remotion": "^4.0.231",
    "@remotion/cli": "^4.0.231",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0"
  },
  "remotion": {
    "entryPoint": "src/Root.tsx"
  }
}
